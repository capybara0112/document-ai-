APP_NAME=Document AI Engine
MAX_UPLOAD_MB=25
MAX_PDF_PAGES=100
# Keep OCR opt-in; install PaddlePaddle + PaddleOCR 3.x before enabling it.
OCR_ENABLED=false
# Optional exported PaddleOCR inference model directories after fine-tuning.
OCR_TEXT_DETECTION_MODEL_DIR=
OCR_TEXT_RECOGNITION_MODEL_DIR=
# auto chooses only useful variants; enhanced/threshold force a corresponding candidate; original keeps a single source candidate.
OCR_PREPROCESS_MODE=auto
# Lines below this PaddleOCR confidence are marked [KHÔNG RÕ] for review
OCR_LOW_CONFIDENCE_THRESHOLD=0.70
# Resource limits for multi-strategy OCR. More candidates increase latency approximately linearly.
OCR_MAX_CANDIDATES=4
OCR_TARGET_SHORT_EDGE=1200
OCR_MAX_DIMENSION=3500
# Optional development-only folder for intermediate candidate images. Leave empty in normal operation.
OCR_DEBUG_IMAGE_DIR=
